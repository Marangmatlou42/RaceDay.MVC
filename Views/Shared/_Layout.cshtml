<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - RaceDay.MVC</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/RaceDay.MVC.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark mb-4">
            <div class="container">
                <a class="navbar-brand" href="/">RaceDay 🏃‍♂️</a>
                <div class="collapse navbar-collapse">
                    <ul class="navbar-nav me-auto">
                        @if (User.IsInRole("Organiser"))
                        {
                            <li class="nav-item"><a class="nav-link" href="/Organiser/Dashboard">Dashboard</a></li>
                        }
                        else if (User.IsInRole("Participant"))
                        {
                            <li class="nav-item"><a class="nav-link" href="/">Upcoming Events</a></li>
                            <li class="nav-item"><a class="nav-link" href="/Participant/MyEnrolments">My Enrolments</a></li>
                            <li class="nav-item"><a class="nav-link" href="/Participant/MyResults">My Results</a></li>
                            <li class="nav-item"><a class="nav-link" href="/Participant/Profile">Profile</a></li>
                        }
                    </ul>
                    <ul class="navbar-nav">
                        @if (User.Identity!.IsAuthenticated)
                        {
                            <li class="nav-item"><a class="nav-link text-danger" href="/Account/Logout">Logout</a></li>
                        }
                        else
                        {
                            <li class="nav-item"><a class="nav-link" href="/Account/Login">Login / Register</a></li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - RaceDay.MVC - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
